<Window x:Class="MalovaniZHodiny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MalovaniZHodiny"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Menu VerticalAlignment="Center" >
            <MenuItem Header="Soubor">
                <MenuItem x:Name="OpenMenuItem" Header="Otevřít" Click="OpenMenuItem_Click"/>
                <MenuItem x:Name="SaveMenuItem" Header="Uložit" Click="SaveMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Upravit" />
        </Menu>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="/brush.png" Width="25" Margin="10"></Image>
            <Label>Tloušťka štětce</Label>
            <Slider Width="100" Minimum="1" Maximum="10" Margin="0,5,0,0"/>
            <Label>Barva</Label>
            <Button x:Name="ColorButton" Width="45" Click="Button_Click"></Button>
        </StackPanel>
        <Canvas Grid.Row="2" Name="DrawingCanvas"/>
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
            
            <Label>0%</Label>
            <Slider Width="100" Margin="0,5,0,0" ></Slider>
            <Label>100%</Label>
        </StackPanel>
        
    </Grid>
</Window>

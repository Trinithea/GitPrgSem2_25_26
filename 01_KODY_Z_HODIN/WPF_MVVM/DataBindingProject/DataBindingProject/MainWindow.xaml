<Window x:Class="DataBindingProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataBindingProject"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button x:Name="btnSet" Content="Set" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Top" Height="44" Width="104" Margin="0,45,0,0" Click="btnSet_Click"/>
        
        <TextBox x:Name="txtInput" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Width="586" Height="66" Text="{Binding BoundText,  UpdateSourceTrigger=PropertyChanged}"/>
        <!-- TextBox je svázaný s vlastností BoundText -->
        <!-- Text = to, co je napsané v TextBoxu -->
        <!-- BoundText = vlastnost v MainWindow (DataContext) -->

        <!-- UpdateSourceTrigger určuje, KDY se změna z TextBoxu
         pošle zpět do proměnné BoundText -->

        <!-- PropertyChanged znamená:
         "Pošli novou hodnotu pokaždé, když se text změní"
         (tedy při každém stisku klávesy; jinak by to bylo pro TextBox až když ztratí fokus) -->
        
        <TextBlock x:Name="tbResult" HorizontalAlignment="Center" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Height="125" Width="780" Text="{Binding BoundText}" />

    </Grid>
</Window>
